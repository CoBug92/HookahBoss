# Local development only. Never reuse these values in production.
DATABASE_URL=postgres://hookahboss:hookahboss@localhost:5432/hookahboss
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
APPLE_CLIENT_ID=ru.kostyuchenko.mixing
SESSION_TOKEN_SECRET=local-development-only-change-me-32-bytes
ADMIN_APPLE_SUBJECTS=
# Required in production. Leave all five unset only in explicit local/test mode.
APPLE_PROVIDER_MODE=disabled
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PROVIDER_CLIENT_ID=
# PEM may use literal \n separators when supplied by an environment manager.
APPLE_PRIVATE_KEY=
# Comma-separated version:base64 pairs; retain old versions until every stored envelope is re-encrypted or deleted.
APPLE_TOKEN_ENCRYPTION_KEYS=
APPLE_TOKEN_KEY_VERSION=
