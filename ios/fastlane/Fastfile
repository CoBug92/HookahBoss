default_platform(:ios)
require "shellwords"
require "uri"

platform :ios do
  ios_dir = File.expand_path("..", __dir__)
  project = File.join(ios_dir, "HookahBoss.xcodeproj")
  scheme = ENV.fetch("SCHEME", "HookahBoss")
  app_identifier = "ru.kostyuchenko.mixing"
  configuration = ENV.fetch("CONFIGURATION", "Debug")
  destination = ENV.fetch("DESTINATION", "platform=iOS Simulator,name=iPhone 17 Pro")
  derived_data = ENV.fetch("DERIVED_DATA_PATH", File.expand_path("../../build/DerivedData", __dir__))

  desc "Regenerate the Xcode project and SwiftGen sources"
  lane :generate do
    Dir.chdir(ios_dir) do
      sh("mkdir -p HookahBoss/Generated")
      sh("swiftgen config run --config swiftgen.yml")
      sh("perl -pi -e 's/[ \\t]+$//' HookahBoss/Generated/*.swift")
      sh("xcodegen generate")
    end
  end

  desc "Run unit tests"
  lane :test do
    generate
    run_tests(
      project: project,
      scheme: scheme,
      configuration: configuration,
      destination: destination,
      derived_data_path: derived_data,
      only_testing: ["HookahBossTests"]
    )
  end

  desc "Build without code signing"
  lane :build do
    generate
    build_app(
      project: project,
      scheme: scheme,
      configuration: configuration,
      destination: ENV.fetch("BUILD_DESTINATION", "generic/platform=iOS"),
      derived_data_path: derived_data,
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "Prepare a local archive; does not export or upload it"
  lane :archive do
    generate
    archive_path = ENV.fetch("ARCHIVE_PATH", File.expand_path("../../build/Mixing.xcarchive", __dir__))
    overrides = {
      "DEVELOPMENT_TEAM" => ENV["DEVELOPMENT_TEAM"],
      "PRODUCT_BUNDLE_IDENTIFIER" => app_identifier,
      "HOOKAHBOSS_RELEASE_API_BASE_URL" => ENV["HOOKAHBOSS_RELEASE_API_BASE_URL"]
    }.compact.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
    build_app(
      project: project,
      scheme: scheme,
      configuration: ENV.fetch("CONFIGURATION", "Release"),
      destination: ENV.fetch("BUILD_DESTINATION", "generic/platform=iOS"),
      archive_path: archive_path,
      derived_data_path: derived_data,
      xcargs: overrides,
      skip_codesigning: ENV.fetch("SKIP_CODE_SIGNING", "false") == "true",
      skip_package_ipa: true
    )
  end

  desc "Create a signed App Store IPA locally; validates config and never uploads"
  lane :release do
    required = %w[DEVELOPMENT_TEAM HOOKAHBOSS_RELEASE_API_BASE_URL]
    missing = required.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing required release environment: #{missing.join(', ')}") unless missing.empty?
    api_url = URI.parse(ENV.fetch("HOOKAHBOSS_RELEASE_API_BASE_URL"))
    UI.user_error!("HOOKAHBOSS_RELEASE_API_BASE_URL must be an HTTPS URL") unless api_url.is_a?(URI::HTTPS) && api_url.host

    generate
    archive_path = ENV.fetch("ARCHIVE_PATH", File.expand_path("../../build/Mixing.xcarchive", __dir__))
    output_directory = ENV.fetch("OUTPUT_DIRECTORY", File.expand_path("../../build", __dir__))
    overrides = ({ "PRODUCT_BUNDLE_IDENTIFIER" => app_identifier }.merge(required.to_h { |key| [key, ENV.fetch(key)] }))
      .map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      destination: "generic/platform=iOS",
      archive_path: archive_path,
      output_directory: output_directory,
      output_name: ENV.fetch("IPA_NAME", "Mixing.ipa"),
      derived_data_path: derived_data,
      export_method: "app-store",
      xcargs: overrides,
      skip_codesigning: false,
      skip_package_ipa: false
    )
  rescue URI::InvalidURIError
    UI.user_error!("HOOKAHBOSS_RELEASE_API_BASE_URL must be a valid HTTPS URL")
  end
end
