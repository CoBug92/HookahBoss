fastlane_version "2.238.0"

require "shellwords"
require "uri"

default_platform(:ios)

APP_IDENTIFIER = "ru.kostyuchenko.mixery"

def required_env(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing required environment variable #{key}") if value.empty?
  value
end

def ios_root
  File.expand_path("../..", __dir__)
end

def project_path
  File.join(ios_root, "HookahBoss.xcodeproj")
end

def scheme
  ENV.fetch("SCHEME", "HookahBoss")
end

def derived_data_path(stage)
  root = ENV.fetch("DERIVED_DATA_PATH", File.join(ios_root, ".build", "DerivedData"))
  File.join(root, stage)
end

def validate_release_api_url!
  uri = URI.parse(required_env("HOOKAHBOSS_RELEASE_API_BASE_URL"))
  UI.user_error!("HOOKAHBOSS_RELEASE_API_BASE_URL must be an HTTPS origin") unless uri.is_a?(URI::HTTPS) && uri.host
rescue URI::InvalidURIError
  UI.user_error!("HOOKAHBOSS_RELEASE_API_BASE_URL must be a valid HTTPS URL")
end

def release_xcargs(extra = {})
  values = {
    "PRODUCT_BUNDLE_IDENTIFIER" => APP_IDENTIFIER,
    "HOOKAHBOSS_RELEASE_API_BASE_URL" => required_env("HOOKAHBOSS_RELEASE_API_BASE_URL")
  }.merge(extra)
  values.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
end

def ensure_deploy_branch!
  branch = ENV["GITHUB_REF_NAME"].to_s.strip
  branch = git_branch if branch.empty?
  allowed = ENV.fetch("DEPLOY_ALLOWED_BRANCHES", "master").split(",").map(&:strip)
  UI.user_error!("Deploy is allowed only from #{allowed.join(', ')}. Current branch: #{branch}") unless allowed.include?(branch)
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: required_env("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: required_env("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: required_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Generate Swift resources and the Xcode project"
  lane :generate do
    sh(File.join(ios_root, "scripts", "swiftgen", "run"))
    sh(File.join(ios_root, "scripts", "xcodegen", "run"))
  end

  desc "Run strict SwiftLint"
  lane :lint do
    sh(File.join(ios_root, "scripts", "swiftlint", "run"))
  end

  desc "Run unit and architecture tests"
  lane :test do
    generate
    run_tests(
      project: project_path,
      scheme: scheme,
      configuration: ENV.fetch("CONFIGURATION", "Debug"),
      destination: ENV.fetch("DESTINATION", "platform=iOS Simulator,name=iPhone 17 Pro"),
      derived_data_path: derived_data_path("test"),
      only_testing: ["HookahBossTests"]
    )
  end

  desc "Build without code signing"
  lane :build do
    generate
    build_app(
      project: project_path,
      scheme: scheme,
      configuration: ENV.fetch("CONFIGURATION", "Debug"),
      destination: ENV.fetch("BUILD_DESTINATION", "generic/platform=iOS"),
      derived_data_path: derived_data_path("build"),
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "Create a local archive without uploading"
  lane :archive do
    validate_release_api_url!
    generate
    build_app(
      project: project_path,
      scheme: scheme,
      configuration: "Release",
      destination: ENV.fetch("BUILD_DESTINATION", "generic/platform=iOS"),
      archive_path: ENV.fetch("ARCHIVE_PATH", File.join(ios_root, ".build", "Mixery.xcarchive")),
      derived_data_path: derived_data_path("archive"),
      xcargs: release_xcargs("DEVELOPMENT_TEAM" => ENV["DEVELOPMENT_TEAM"].to_s),
      skip_codesigning: ENV.fetch("SKIP_CODE_SIGNING", "false") == "true",
      skip_package_ipa: true
    )
  end

  desc "Create a signed App Store IPA locally without uploading"
  lane :release do
    validate_release_api_url!
    team_id = required_env("TEAM_ID")
    generate
    build_app(
      project: project_path,
      scheme: scheme,
      configuration: "Release",
      destination: "generic/platform=iOS",
      archive_path: ENV.fetch("ARCHIVE_PATH", File.join(ios_root, ".build", "Mixery.xcarchive")),
      output_directory: ENV.fetch("OUTPUT_DIRECTORY", File.join(ios_root, ".build")),
      output_name: ENV.fetch("IPA_NAME", "Mixery.ipa"),
      derived_data_path: derived_data_path("release"),
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: release_xcargs("DEVELOPMENT_TEAM" => team_id)
    )
  end

  desc "Increment the build, sign with match and upload to TestFlight"
  lane :deploy do
    ensure_deploy_branch!
    validate_release_api_url!
    team_id = required_env("TEAM_ID")
    api_key = app_store_connect_key
    marketing_version = ENV.fetch("MARKETING_VERSION", "1.0.0")
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: marketing_version,
      initial_build_number: 0
    ) + 1

    setup_ci(force: true, timeout: 0)
    match(type: "appstore", readonly: true, app_identifier: APP_IDENTIFIER, api_key: api_key)
    generate
    build_app(
      project: project_path,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: team_id,
      include_symbols: true,
      output_directory: ENV.fetch("OUTPUT_DIRECTORY", File.join(ios_root, ".build")),
      output_name: ENV.fetch("IPA_NAME", "Mixery.ipa"),
      xcargs: release_xcargs(
        "DEVELOPMENT_TEAM" => team_id,
        "MARKETING_VERSION" => marketing_version,
        "CURRENT_PROJECT_VERSION" => build_number.to_s
      ),
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}" }
      }
    )
    upload_to_testflight(api_key: api_key)
  end

  desc "Alias for deploy"
  lane :deploy_to_tf do
    deploy
  end
end
