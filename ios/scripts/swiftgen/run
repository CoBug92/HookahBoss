#!/bin/sh

set -eu
TOOL_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$TOOL_DIRECTORY/../common.sh"

actual_version="$(swiftgen --version | awk '{print $2}' | sed 's/^v//')"
if [ "$actual_version" != "6.6.3" ]; then
    printf 'Expected SwiftGen 6.6.3, found %s\n' "$actual_version" >&2
    exit 1
fi

mkdir -p "$PROJECT_DIRECTORY/HookahBoss/Generated"
cd "$TOOL_DIRECTORY"
swiftgen config run --config swiftgen.yml
perl -pi -e 's/[ \t]+$//' "$PROJECT_DIRECTORY"/HookahBoss/Generated/*.swift
