#!/bin/sh

set -eu
TOOL_DIRECTORY="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$TOOL_DIRECTORY/../common.sh"

actual_version="$(swiftlint version)"
if [ "$actual_version" != "0.65.0" ]; then
    printf 'Expected SwiftLint 0.65.0, found %s\n' "$actual_version" >&2
    exit 1
fi

cd "$PROJECT_DIRECTORY"
exec swiftlint lint --strict --no-cache --config "$TOOL_DIRECTORY/.swiftlint.yml" \
    HookahBoss HookahBossTests HookahBossUITests
